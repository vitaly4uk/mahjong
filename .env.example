# Copy this file to .env and fill in what you need — .env is gitignored and
# auto-loaded by config/settings.py (environ.Env.read_env). See CLAUDE.md
# ("Configuration via env") for what each variable does in production.

# Required locally: DEBUG now defaults to False (config/settings.py), so
# without this the app raises ImproperlyConfigured on the missing
# DJANGO_SECRET_KEY before it ever gets to the dev fallback key.
DJANGO_DEBUG=True

# Only needed with DJANGO_DEBUG=False — a random 50+ char string in
# production, never the same value across environments.
# DJANGO_SECRET_KEY=

# Only needed with DJANGO_DEBUG=False — comma-separated hostnames, e.g.
# mahjong.vitaly4uk.in.ua
# DJANGO_ALLOWED_HOSTS=

# Optional — enables the game's background photo (config/api.py). Without
# it the background endpoint returns {"url": null} and the game falls back
# to its default color; nothing else is affected.
# PEXELS_API_KEY=

# Optional — overrides the default sqlite:///db.sqlite3 (dj-environ URL
# form, e.g. postgres://user:pass@host:5432/dbname).
# DATABASE_URL=

# Optional — points the cache (gameplay/ratelimit.py's per-IP quotas,
# config/api.py's Pexels photo pool) at a shared Redis instead of Django's
# default per-process LocMemCache. Unset is fine for local dev. Use a
# database index dedicated to this app (not shared with another service) —
# gameplay/tests.py's setUp calls cache.clear() (FLUSHDB) freely, since
# everything in this cache is derived/ephemeral. See CLAUDE.md
# ("Configuration via env") and DEPLOY.local.md for the real production URL.
# REDIS_URL=redis://127.0.0.1:6379/1
